            {
              "span": "trotzdem",
              "violates": [
                "causal-reading"
              ],
              "rationale": "trotzdem marks a concession (\"despite the lateness\"); the lateness supports going home, so the reading contradicts the sentence."
            }
          ],
          "register": "informal spoken German; past tense; the cause precedes the consequence",
          "formats": [
            "mcq",
            "typed"
          ]
        }
      ]
    },
