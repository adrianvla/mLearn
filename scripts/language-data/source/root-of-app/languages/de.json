            {
              "span": "trotzdem",
              "violates": [
                "causal-reading"
              ],
              "rationale": "trotzdem marks a concession contrary to the main clause; having an exam tomorrow supports studying, it does not oppose it."
            }
          ],
          "register": "informal spoken German; present tense; the cause precedes the consequence",
          "formats": [
            "mcq",
            "typed"
          ]
        },
        {
          "id": "de-deshalb-hause-2",
          "context": "Es war sehr spät, deshalb bin ich schnell nach Hause gegangen.",
          "answerSpan": "deshalb",
          "conditions": [
            "main-clause-verb-second",
            "causal-reading"
          ],
          "distractors": [
            {
              "span": "weil",
              "violates": [
                "main-clause-verb-second"
              ],
              "rationale": "weil must introduce a subordinate clause with the verb at the end; the continuation \"bin ich … gegangen\" has the verb in second position, so weil cannot join it as written."
