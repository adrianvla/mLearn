    {
      "pattern": "haben/sein + Partizip II",
      "level": 2,
      "meaning": "Perfekt: conversational past with haben or sein",
      "meanings": {
        "de": "Perfekt: gesprochenes Präteritum mit haben oder sein"
      }
    },
    {
      "pattern": "um … zu",
      "level": 2,
      "meaning": "purpose infinitive: in order to",
      "meanings": {
        "de": "Finalsatz: um etwas zu tun"
      }
    },
    {
      "pattern": "seit + Dativ",
      "level": 2,
      "meaning": "since/for (a point or span of time)",
      "meanings": {
        "de": "seit einem Zeitpunkt oder einer Zeitspanne (Dativ)"
      }
    },
    {
      "pattern": "weil",
      "level": 3,
      "meaning": "causal subordinator; the verb goes to the end",
      "meanings": {
        "de": "kausaler Nebensatz; das Verb steht am Ende"
      },
      "contrasts": [
        "deshalb",
        "obwohl"
      ],
      "items": [
        {
          "id": "de-weil-fieber-1",
          "context": "Ich bleibe heute im Bett, weil ich Fieber habe.",
          "answerSpan": "weil",
          "conditions": [
            "subordinate-clause-final-verb",
            "causal-reading"
          ],
          "distractors": [
            {
              "span": "deshalb",
              "violates": [
                "subordinate-clause-final-verb"
              ],
              "rationale": "deshalb joins a main clause with the verb in second position; the continuation \"ich Fieber habe\" has the verb at the end, so deshalb cannot join it as written (\"deshalb habe ich Fieber\" would be the adverb form)."
            },
            {
              "span": "obwohl",
              "violates": [
                "causal-reading"
              ],
              "rationale": "obwohl marks a concession that contradicts the main clause; a fever supports staying in bed, it does not oppose it."
            }
          ],
          "register": "informal spoken German; present tense; the cause supports the main clause",
          "formats": [
            "mcq",
            "typed"
          ]
        },
        {
          "id": "de-weil-studium-2",
          "context": "Ich lerne jeden Tag Deutsch, weil ich nächstes Jahr in Deutschland studieren möchte.",
          "answerSpan": "weil",
          "conditions": [
            "subordinate-clause-final-verb",
            "causal-reading"
          ],
          "distractors": [
            {
              "span": "deshalb",
              "violates": [
                "subordinate-clause-final-verb"
              ],
              "rationale": "deshalb joins a main clause with the verb in second position; the continuation \"ich … studieren möchte\" has the verb at the end, so deshalb cannot join it as written."
            },
            {
              "span": "obwohl",
              "violates": [
                "causal-reading"
              ],
              "rationale": "obwohl marks a concession that contradicts the main clause; wanting to study in Germany supports learning German every day, it does not oppose it."
            }
          ],
          "register": "informal spoken German; present tense; the reason supports the main clause",
          "formats": [
            "mcq",
            "typed"
          ]
        }
      ]
    },
    {
      "pattern": "obwohl",
      "level": 3,
      "meaning": "concessive subordinator; the verb goes to the end",
      "meanings": {
        "de": "konzessiver Nebensatz; das Verb steht am Ende"
      },
      "contrasts": [
        "weil"
      ],
      "items": [
        {
          "id": "de-obwohl-regen-1",
          "context": "Wir gehen spazieren, obwohl es regnet.",
          "answerSpan": "obwohl",
          "conditions": [
            "concessive-reading",
            "subordinate-clause-final-verb"
          ],
          "distractors": [
            {
              "span": "weil",
              "violates": [
                "concessive-reading"
              ],
              "rationale": "weil gives a causal reading; rain opposes the walk, it does not cause it."
            },
            {
              "span": "deshalb",
              "violates": [
                "concessive-reading",
                "subordinate-clause-final-verb"
              ],
              "rationale": "deshalb is a causal adverb joining a verb-second main clause (\"deshalb regnet es\"); it is ungrammatical here and gives the wrong reading."
            }
          ],
          "register": "informal spoken German; present tense; the subordinate clause opposes the main clause",
          "formats": [
            "mcq",
            "typed"
          ]
        },
        {
          "id": "de-obwohl-krank-2",
          "context": "Er ist zur Arbeit gegangen, obwohl er krank war.",
          "answerSpan": "obwohl",
          "conditions": [
            "concessive-reading",
            "subordinate-clause-final-verb"
          ],
          "distractors": [
            {
              "span": "weil",
              "violates": [
                "concessive-reading"
              ],
              "rationale": "weil gives a causal reading; \"because he was sick he went to work\" contradicts the main clause — being sick opposes going to work, it does not cause it."
            },
            {
              "span": "deshalb",
              "violates": [
                "concessive-reading",
                "subordinate-clause-final-verb"
              ],
              "rationale": "deshalb needs a verb-second continuation, but \"er krank war\" is verb-final; its causal reading would also contradict the main clause."
            }
          ],
          "register": "informal spoken German; past tense; the subordinate clause opposes the main clause",
          "formats": [
            "mcq",
            "typed"
          ]
        }
      ]
    },
    {
      "pattern": "deshalb",
      "level": 3,
      "meaning": "causal adverb; the verb stays in second position",
      "meanings": {
        "de": "kausales Adverb; das Verb bleibt auf Position 2"
      },
      "contrasts": [
