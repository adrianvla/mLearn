          ],
          "distractors": [
            {
              "span": "weil",
              "violates": [
                "main-clause-verb-second"
              ],
              "rationale": "weil introduces a subordinate clause with the verb at the end; the continuation \"lerne ich heute den ganzen Tag\" has the verb in second position (\"weil ich heute den ganzen Tag lerne\" would be the subordinate form)."
