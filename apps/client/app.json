{
  "expo": {
    "name": "mLearn v3 Dev",
    "slug": "mlearn-v3-dev",
    "version": "3.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "mlearn-v3-dev",
    "userInterfaceStyle": "automatic",
    "ios": { "icon": "./assets/expo.icon", "bundleIdentifier": "net.kikan.mlearn.v3dev" },
    "android": {
      "adaptiveIcon": { "backgroundColor": "#E6F4FE", "foregroundImage": "./assets/images/android-icon-foreground.png", "backgroundImage": "./assets/images/android-icon-background.png", "monochromeImage": "./assets/images/android-icon-monochrome.png" },
      "predictiveBackGestureEnabled": false,
      "package": "net.kikan.mlearn.v3dev"
    },
    "web": { "output": "single", "favicon": "./assets/images/favicon.png", "bundler": "metro" },
    "plugins": ["expo-router", ["expo-splash-screen", { "backgroundColor": "#F1F2F4", "image": "./assets/images/splash-icon.png", "imageWidth": 76 }]],
    "experiments": { "typedRoutes": true, "reactCompiler": true }
  }
}